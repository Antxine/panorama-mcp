# Panorama (single target mode). For several targets use panos-keygen / firewalls.json.
PANOS_HOST=panorama.example.local
PANOS_API_KEY=your-api-key-here

# Read-only by default: write tools (set/delete/commit/push, run_op_command) are not registered.
PANOS_READ_ONLY=true

# Modules to load: "all", a comma-separated list, or the "panorama-debug" preset
# (firewalls, panorama, utility, debug, urlcategories, diagnose).
PANOS_MODULES=panorama-debug
